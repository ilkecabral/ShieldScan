# ============================================================
# ShieldScan — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is in .gitignore.
#
# Quick-start for local dev:
#   1. cp .env.example .env
#   2. Fill in JWT_SECRET_KEY + AWS_ENCRYPTION_KEY (commands below)
#   3. Set AI_PROVIDER=groq + GROQ_API_KEY (free at console.groq.com)
#   4. docker compose up -d
#
# Quick-start for Oracle Cloud / Hetzner production:
#   → See DEPLOY.md for the full step-by-step guide
# ============================================================


# ── Application ─────────────────────────────────────────────
# dev | staging | production
# production activates: CloudWatch logging, stricter error messages
ENV=development

# Your public URL — used in email links and CORS
APP_URL=http://localhost:8000
# APP_URL=https://shieldscan.duckdns.org   # Oracle Cloud / DuckDNS


# ── Database ─────────────────────────────────────────────────
# Local dev (SQLite — no setup required, not for production):
DATABASE_URL=sqlite:///./shieldscan.db

# Docker Compose (auto-set by docker-compose.yml — don't change here):
# DATABASE_URL=postgresql://shieldscan:PASS@db:5432/shieldscan

# External PostgreSQL (staging / production without Docker db service):
# DATABASE_URL=postgresql://shieldscan:STRONG_PASS@localhost:5432/shieldscan


# ── Security — REQUIRED ──────────────────────────────────────
# Both keys are REQUIRED. The app will crash on startup if either is missing or weak.

# JWT signing key — must be ≥ 32 characters.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Fernet key for encrypting user AWS credentials at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AWS_ENCRYPTION_KEY=

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60


# ── Admin account ────────────────────────────────────────────
# Seeded on first startup. Leave ADMIN_PASSWORD blank to skip.
ADMIN_EMAIL=admin@shieldscan.io
# Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_PASSWORD=


# ── CORS ─────────────────────────────────────────────────────
# JSON array of allowed origins. Must match your actual domain in prod.
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]
# Production (replace with your DuckDNS / real domain):
# CORS_ALLOWED_ORIGINS=["https://shieldscan.duckdns.org"]


# ── AI Provider — REQUIRED for chat feature ──────────────────
# Options: groq (recommended free) | ollama (local) | claude (paid)

# ── Groq — FREE, 14,400 req/day, no credit card needed ──────
# Get key: https://console.groq.com → API Keys → Create key
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Ollama (local dev only — needs ollama running on your machine) ──
# AI_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# ── Claude API (paid, highest quality) ───────────────────────
# AI_PROVIDER=claude
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-4-5-20251001


# ── ChromaDB (RAG vector store) ──────────────────────────────
# Docker Compose sets these automatically via docker-compose.yml.
# Only set manually for standalone ChromaDB (non-Docker deployment).
# CHROMA_HOST=localhost
# CHROMA_PORT=8001


# ── Email (transactional — optional) ─────────────────────────
# Used for: email verification, password reset, account recovery.
# Gmail setup: enable 2FA → myaccount.google.com/apppasswords → create App Password
# Without SMTP: email features are skipped (verification codes are logged instead).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=       # 16-char Gmail App Password (spaces removed)
EMAIL_FROM=ShieldScan <your@gmail.com>


# ── AWS (for CSPM scanning — optional at startup) ────────────
# These are the SERVER's own AWS credentials, not the user's.
# In production on Oracle Cloud: paste an IAM user's access key here.
# (On EC2: use instance profile instead — no keys needed.)
# AWS_REGION=eu-west-3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=


# ── AWS Secrets Manager (optional — leave blank for .env mode) ──
# Set this to read all secrets from Secrets Manager instead of .env.
# SECRETS_MANAGER_SECRET_NAME=shieldscan/production/secrets


# ── CloudWatch Logging (production only) ─────────────────────
# Activated automatically when ENV=production.
# Requires AWS credentials above with logs:PutLogEvents permission.
# CLOUDWATCH_LOG_GROUP=/shieldscan/api
# CLOUDWATCH_STREAM=backend


# ── Performance tuning ───────────────────────────────────────
# Oracle Cloud ARM 4-core: use 4 workers
# Hetzner CX21 2-core: use 2 workers
UVICORN_WORKERS=2
